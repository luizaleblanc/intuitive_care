{
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p public && echo 'Intuitive Care API' > public/index.html",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
