# Ambiente da API (development | production | test)
APP_ENV=development
FLASK_DEBUG=true

# Banco de Dados (mysql | sqlite)
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root
DB_NAME=intuitive_care

# Segurança / Sessão
SECRET_KEY=troque-esta-chave-em-producao
TOKEN_EXPIRATION_HOURS=12
RESET_CODE_EXPIRATION_MINUTES=15

# Serviço de E-mail para Recuperação de Senha (mock | resend | brevo | smtp)
EMAIL_PROVIDER=mock
EMAIL_FROM=noreply@intuitivecare.com.br
RESEND_API_KEY=
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
