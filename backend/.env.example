# Ambiente da API (development | production | test)
APP_ENV=development
FLASK_DEBUG=true

# Banco de Dados (mysql | sqlite)
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=root
DB_NAME=intuitive_care

# Segurança / Sessão
SECRET_KEY=troque-esta-chave-em-producao
TOKEN_EXPIRATION_HOURS=12
RESET_TOKEN_EXPIRA_MIN=30
FRONTEND_URL=http://localhost:8080

# E-mail de redefinição de senha (smtp | console | resend | brevo)
# console imprime o link no log da API. Com smtp + mailpit, veja em http://localhost:8025
MAIL_MODO=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
RESEND_API_KEY=
BREVO_API_KEY=
